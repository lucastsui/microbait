# Local HTTP port for the desktop window and `npm run server`.
PORT=3847

# Grok CLI. Leave GROK_BIN empty to use ~/.grok/bin/grok.
# Point GROK_BIN at another command if you want a different CLI.
GROK_BIN=
GROK_MODEL=
GROK_REASONING=low
GROK_EXTRA_ARGS=

# OpenCode API. Default URL is OpenCode Zen chat completions.
# Get a key at https://opencode.ai/auth
# Point OPENCODE_URL at http://127.0.0.1:4096 to use `opencode serve` instead.
OPENCODE_API_KEY=
OPENCODE_URL=
OPENCODE_MODEL=big-pickle
MICROBAIT_AI=
